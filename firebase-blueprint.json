{
  "entities": {
    "UserWallet": {
      "title": "UserWallet",
      "description": "Registered EverMore user profile and wallet state.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "balance": { "type": "number" },
        "invitesCount": { "type": "number" },
        "checkInCount": { "type": "number" },
        "earnedTotal": { "type": "number" },
        "purchasedCodes": { "type": "array" },
        "lastClaimDate": { "type": "string", "maxLength": 20 },
        "transactions": { "type": "array" },
        "watchedVideoIds": { "type": "array" },
        "accountTier": { "type": "string", "enum": ["Starter", "Silver", "Gold VIP"] },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "name", "email", "balance", "accountTier", "createdAt"]
    },
    "CompanyBankConfig": {
      "title": "CompanyBankConfig",
      "description": "Company bank account details shown on Ecoin and Upgrade payment pages.",
      "type": "object",
      "properties": {
        "bankName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "accountNumber": { "type": "string", "minLength": 10, "maxLength": 10 },
        "accountName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["bankName", "accountNumber", "accountName"]
    },
    "EcoinSubmission": {
      "title": "EcoinSubmission",
      "description": "User payment proof submitted for Ecoin withdrawal code approval.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 120 },
        "userEmail": { "type": "string", "maxLength": 160 },
        "plan": { "type": "string", "enum": ["standard", "pro"] },
        "amount": { "type": "number" },
        "receiptName": { "type": "string", "maxLength": 200 },
        "receiptPreviewUrl": { "type": "string", "maxLength": 600000 },
        "status": { "type": "string", "enum": ["pending", "approved", "declined"] },
        "ecoinCode": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "userName", "userEmail", "plan", "amount", "receiptName", "status", "createdAt"]
    },
    "UpgradeSubmission": {
      "title": "UpgradeSubmission",
      "description": "User payment proof submitted for account tier upgrade approval.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 120 },
        "userEmail": { "type": "string", "maxLength": 160 },
        "tier": { "type": "string", "enum": ["Silver", "Gold VIP"] },
        "amount": { "type": "number" },
        "receiptName": { "type": "string", "maxLength": 200 },
        "receiptPreviewUrl": { "type": "string", "maxLength": 600000 },
        "status": { "type": "string", "enum": ["pending", "approved", "declined"] },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "userName", "userEmail", "tier", "amount", "receiptName", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserWallet" },
      "description": "Individual user profile, wallet balance, transactions, and tier state."
    },
    "/appConfig/{docId}": {
      "schema": { "$ref": "#/entities/CompanyBankConfig" },
      "description": "Global EverMore configuration documents such as companyBank."
    },
    "/ecoinSubmissions/{submissionId}": {
      "schema": { "$ref": "#/entities/EcoinSubmission" },
      "description": "Ecoin code payment receipts awaiting admin approval or decline."
    },
    "/upgradeSubmissions/{submissionId}": {
      "schema": { "$ref": "#/entities/UpgradeSubmission" },
      "description": "Account upgrade payment receipts awaiting admin approval or decline."
    }
  }
}
